# Copiar a .env y ajustar. No versionar el .env con valores reales.
# NODE_ENV es obligatorio: sin valor por defecto, para no caer en 'development' por accidente.
NODE_ENV=development
# El backend usa 3001; el 3000 queda para Next.js.
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://rodando:rodando@localhost:5432/rodando
