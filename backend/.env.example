# Copiar a .env y ajustar. No versionar el .env con valores reales.
# NODE_ENV es obligatorio: sin valor por defecto, para no caer en 'development' por accidente.
NODE_ENV=development
# El backend usa 3001; el 3000 queda para Next.js.
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://rodando:rodando@localhost:5432/rodando
# Orígenes de navegador permitidos por CORS, separados por comas (ver docs/15).
# Este es el portal en desarrollo; en producción va el origen real.
# Vacío: la API no emite ningún encabezado CORS.
CORS_ORIGINS=http://localhost:3000
# Dónde se guardan las imágenes de los reportes, relativo al proceso. Es el
# `backend/uploads/` de siempre; el backend lo crea si no existe.
UPLOAD_DIR=uploads
# La URL pública de esos archivos, sin barra final: es la que se guarda en
# `reports.image_url`. En producción va el dominio real, y quien sirva
# `/uploads` puede ser el proxy (ver docs/03 y docs/17).
UPLOAD_BASE_URL=http://localhost:3001/uploads
