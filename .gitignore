# Artefactos del sistema y del editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Registros y temporales
*.log
*.tmp

# Datos crudos de OpenStreetMap: los PBF y los extractos nuevos no se versionan.
# El extracto de la zona piloto sí: es el snapshot que alimenta el grafo del MVP
# (ver data/README.md).
data/*.pbf
data/*.osm
!data/pilot-zone.osm

# El relevamiento completo vive en el Drive del equipo (ver
# data/relevamiento/README.md). Acá sólo se versiona la plantilla.
data/relevamiento/relevamiento-*.csv

