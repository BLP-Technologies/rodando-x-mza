# Artefactos del sistema y del editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Registros y temporales
*.log
*.tmp

# Datos crudos de OpenStreetMap: se regeneran con scripts/fetch-pilot-zone-osm.mjs
