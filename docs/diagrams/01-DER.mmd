erDiagram
    %% Valores cerrados: ver docs/09-modelo-de-datos.md %%
    %% Enums: accessibility_level (FULL, PARTIAL, NONE), obstacle_severity (MINOR,
    %% MODERATE, CRITICAL), report_status (PENDING, APPROVED, UNDER_REPAIR,
    %% RESOLVED, REJECTED). Todos nullable: NULL = no determinado. %%

    USERS {
        int id PK
        varchar(50) name
        varchar(200) email
        varchar(255) password_hash
        boolean is_moderator
        datetime created_at
        datetime updated_at
        datetime? deleted_at
    }

    USER_PLACES {
        int id PK
        int user_id FK
        varchar(100) name
        varchar(300)? description
        geometry(Point) geom
        datetime created_at
        datetime updated_at
    }

    SAVED_ROUTES {
        int id PK
        int user_id FK
        varchar(100) name "ej: Ir al trabajo"
        geometry(Point) start_point "Punto A (Origen)"
        geometry(Point) end_point "Punto B (Destino)"
        datetime created_at
        datetime updated_at
    }

    %% Nodos de conexión / Esquinas %%
    KERB_NODES {
        int id PK
        geometry(Point) geom
        accessibility_level? accessibility_level "FULL, PARTIAL, NONE; NULL = no determinado"
        boolean is_verified "Un moderador confirmó el valor"
    }

    %% Vereda, de cordón a cordón %%
    SIDEWALKS {
        int id PK
        int start_node_id FK
        int end_node_id FK
        bigint osm_way_id "FK externo"
        varchar(100)? street_name
        accessibility_level? accessibility_level "FULL, PARTIAL, NONE; NULL = no determinado"
        geometry(LineString) geom
        boolean is_verified "Un moderador confirmó el valor"
        float? width "Ancho de vereda"
    }

    %% Cruce peatonal sobre calzada %%
    CROSSINGS {
        int id PK
        int start_node_id FK
        int end_node_id FK
        geometry(LineString) geom
        boolean has_traffic_light
        accessibility_level? accessibility_level "FULL, PARTIAL, NONE; NULL = no determinado"
        boolean is_verified "Un moderador confirmó el valor"
    }

    %% Obstáculos o barreras físicas puntuales %%
    OBSTACLES {
        int id PK
        int? sidewalk_id FK
        int type_id FK
        geometry(Point) geom
        obstacle_severity severity "MINOR, MODERATE, CRITICAL"
        boolean is_resolved
        datetime created_at
        datetime updated_at
        datetime? deleted_at
    }

    %% Catálogo de tipos de obstáculo %%
    OBSTACLE_TYPES {
        int id PK
        varchar(40) code "POTHOLE, TREE, STEP, STEEP_SLOPE, NARROWING; inmutable en la API"
        varchar(80) name_es "Etiqueta para el portal"
        boolean is_active "Baja lógica del catálogo"
        datetime created_at
        datetime updated_at
    }

    %% Reporte de obstáculos. No crea el obstáculo %%
    REPORTS {
        int id PK
        int user_id FK
        varchar(300) description
        geometry(Point) geom
        varchar(300)? image_url
        report_status status "PENDING, APPROVED, UNDER_REPAIR, RESOLVED, REJECTED"
        int? obstacle_id FK "Relación opcional con un obstáculo"
        datetime created_at
        datetime updated_at
        datetime? deleted_at
    }

    TUTORIALS {
        int id PK
        int category_id FK
        varchar(100) title
        varchar(300) description
        varchar(300) video_url
        datetime created_at
        datetime updated_at
        datetime? deleted_at
    }

    %% Catálogo de categorías de tutorial %%
    TUTORIAL_CATEGORIES {
        int id PK
        varchar(40) code "Inmutable en la API"
        varchar(80) name_es "Etiqueta para el portal"
        boolean is_active "Baja lógica del catálogo"
        datetime created_at
        datetime updated_at
    }

    %% Tutoriales guardados por un usuario. Sin updated_at: sus columnas son inmutables %%
    USER_TUTORIALS {
        int id PK
        int user_id FK
        int tutorial_id FK
        datetime created_at
    }

    USERS ||--o{ USER_PLACES: "Tiene lugares favoritos"
    USERS ||--o{ SAVED_ROUTES: "Puede guardar rutas"
    KERB_NODES ||--o{ SIDEWALKS: "Nodo de inicio y fin"
    KERB_NODES ||--o{ CROSSINGS: "Nodo de inicio y fin"
    SIDEWALKS ||--o{ OBSTACLES: "Puede tener obstáculos"
    OBSTACLE_TYPES ||--o{ OBSTACLES: "Clasifica"
    USERS ||--o{ REPORTS: "Puede reportar obstáculos"
    OBSTACLES ||--o{ REPORTS: "Reporta un obstáculo"
    TUTORIAL_CATEGORIES ||--o{ TUTORIALS: "Agrupa"
    USERS ||--o{ USER_TUTORIALS: "Tiene tutoriales guardados"
    TUTORIALS ||--o{ USER_TUTORIALS: "Es guardado por un usuario"
