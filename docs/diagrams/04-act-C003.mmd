swimlane-beta LR
accTitle: C003 Planificar recorrido accesible - diagrama de actividades
accDescr: Flujo del cálculo de un recorrido accesible, desde que la persona ubica el origen y el destino en el mapa hasta que ve el recorrido, con la validación de las puntas contra la red de seguridad, el costo derivado de cada arista y el caso en que no hay recorrido accesible.

subgraph U["Usuario"]
  inicio(["Inicio"])
  definir["Define ORIGEN y DESTINO en NUEVO RECORRIDO"]
  ubicar["Ubica cada pin en el mapa"]
  buscar["Presiona BUSCAR RECORRIDO ACCESIBLE"]
  verMapa["Ve el recorrido en el mapa"]
  decidir{"¿Qué hace con el recorrido?"}
  fin(["Fin"])
end

subgraph A["App Mobile"]
  completo{"¿Están los dos puntos definidos?"}
  aviso["Informa el error y pide revisar los datos"]
  pedido["POST /api/routes/calculate(origin, destination)"]
  mostrarSinRuta["Informa que no hay recorrido accesible entre esos puntos"]
  autenticado{"¿Usuario autenticado?"}
  guardar["Guarda el recorrido en la cuenta"]
  pedirCuenta["Avisa que debe iniciar sesión o crear cuenta"]
  detalle["Abre DETALLE DEL RECORRIDO"]
  render["Muestra distancia, tramos y advertencias"]
end

subgraph B["Backend"]
  zona{"¿Las dos puntas están dentro de la red de seguridad?"}
  rechazo["Responde 400: OUTSIDE_SERVICE_AREA"]
  ruteo["Calcula el recorrido con el costo de cada arista"]
  hayRuta{"¿Existe recorrido accesible?"}
  trazar["Devuelve el recorrido, su detalle y el pegado de cada punta"]
  sinRuta["Devuelve found: false"]
end

subgraph D["Base de Datos (PostGIS)"]
  pega["Pega cada punta al cordón más cercano"]
  grafo["Recorre el grafo de veredas y cruces"]
  costear["Deriva el costo de cada arista: metros por accesibilidad más las penalizaciones"]
  componentes["Compara el componente conectado del origen y del destino"]
  tramos["Devuelve los tramos del recorrido"]
end

inicio --> definir
definir --> ubicar
ubicar --> buscar
buscar --> completo
completo -->|No| aviso
aviso --> ubicar
completo -->|Sí| pedido
pedido --> zona
zona -->|No| rechazo
rechazo --> fin
zona -->|Sí| pega
pega --> grafo
grafo --> costear
costear --> componentes
componentes --> ruteo
ruteo --> hayRuta
hayRuta -->|Sí| tramos
hayRuta -->|No| sinRuta
tramos --> trazar
trazar --> render
sinRuta --> mostrarSinRuta
mostrarSinRuta --> fin
render --> verMapa
verMapa --> decidir
decidir -->|Ver detalle| detalle
decidir -->|Guardar recorrido| autenticado
autenticado -->|Sí| guardar
autenticado -->|No| pedirCuenta
decidir -->|Finalizar| fin
detalle --> fin
guardar --> fin
pedirCuenta --> fin
